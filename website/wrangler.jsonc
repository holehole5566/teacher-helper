{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teacher-helper-website",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "teacher-helper.pe4nut.com", "custom_domain": true }],
}
